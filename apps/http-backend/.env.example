# HTTP Backend Environment Variables
# Copy this file to .env and fill in the values.

# REQUIRED: Secret key for signing and verifying JWTs.
# Generate a strong one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This MUST also be set in your Render dashboard under Environment Variables.
# The same value must be used in BOTH http-backend and ws-backend.
JWT_SECRET=

# Optional: Port to run on (defaults to 3001)
PORT=3001

# Database connection URL (set by Render automatically if using Render Postgres)
DATABASE_URL=
