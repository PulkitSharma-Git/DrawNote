# WS Backend Environment Variables
# Copy this file to .env and fill in the values.

# REQUIRED: Secret key for verifying JWTs on WebSocket connections.
# Must be the SAME value as JWT_SECRET in http-backend — tokens are signed there
# and verified here. If they differ, all WS connections will be rejected.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: Port to run on (defaults to 8080)
PORT=8080

# Database connection URL
DATABASE_URL=
